# Copy to .env and fill in as needed. All variables are optional.

# HuggingFace mirror. Unset to use the default https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# Run fully offline once backbones are pre-downloaded (uncomment):
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# Where checkpoints / caches / precomputed flow are written (read by launch scripts)
EVO_ROOT=/path/to/evo_workspace

# Where downloaded datasets live
DATA_ROOT=/path/to/datasets

# Number of GPUs / processes per node (defaults to each job's original worker count)
NUM_GPUS=4

# Optional cloud experiment logging. Training defaults to --disable_wandb;
# set a key here only if you enable logging.
# SWANLAB_API_KEY=
# WANDB_API_KEY=
